# Copie para .env.local (que o Git ignora) e preencha.

# TMDB → themoviedb.org → Configurações → API → "API Read Access Token" (o token comprido).
# Usado pelos scripts de capas/temporadas e pela rota /api/episodes (só no servidor).
TMDB_READ_TOKEN=

# Supabase → Project Settings → API Keys.
# Ambas são públicas (vão para o navegador); quem protege os dados é o RLS.
# NUNCA coloque aqui a chave secreta (service_role / sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
